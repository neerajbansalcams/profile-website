{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    },
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.ts" },
    { "src": "/claude-agent-tsunami", "headers": { "Location": "/blog/claude-agent-tsunami" }, "status": 301 },
    { "src": "/stop-prompting-start-orchestrating", "headers": { "Location": "/blog/stop-prompting-start-orchestrating" }, "status": 301 },
    { "src": "/claude-agents-in-my-workflow", "headers": { "Location": "/blog/claude-agents-in-my-workflow" }, "status": 301 },
    { "src": "/((?!assets/|favicon_io/).*)", "dest": "/index.html" }
  ]
}